DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adaptive_presence_os?schema=public"
NEXT_PUBLIC_APP_URL="https://your-public-app-domain.example"
# Self-service passwordless email authentication.
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional separate encryption secret for per-brand Telegram/VK credentials.
# If unset, AUTH_SECRET is used. Keep stable after channels are connected.
CHANNEL_CREDENTIAL_SECRET="replace-with-another-long-random-secret"
# Vercel Cron sends this value as an Authorization Bearer token.
CRON_SECRET="replace-with-a-long-random-secret"
AUTH_RESEND_KEY="re_replace_me"
AUTH_EMAIL_FROM="Adaptive Presence <login@your-domain.ru>"
# Comma-separated emails allowed to open the legacy manager console at /manager.
MANAGER_EMAILS="owner@your-domain.ru"
OPENAI_API_KEY="sk-proj-replace-me"
TEXT_MODEL_DEFAULT="gpt-5.6-terra"
TEXT_MODEL_PREMIUM="gpt-5.6-sol"
TEXT_MODEL_FAST="gpt-5.6-luna"
TEXT_MODEL_STRATEGY="gpt-5.6-sol"
TEXT_MODEL_MONTHLY_PLAN="gpt-5.6-sol"
TEXT_MODEL_CONTENT="gpt-5.6-terra"
TEXT_MODEL_CREATIVE_BRIEF="gpt-5.6-terra"
TEXT_REASONING_EFFORT_STRATEGY="medium"
TEXT_REASONING_EFFORT_CONTENT="low"
TEXT_REASONING_EFFORT_CREATIVE="medium"
# OPENAI_MODEL="gpt-4.1-mini" # Optional legacy fallback when task-specific models are not set.
AUTOPILOT_TEXT_BATCH_LIMIT="5"
VISUAL_PROVIDER="openai"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
OPENAI_IMAGE_MODEL="gpt-image-2"
# Leave unset to choose a platform-native size automatically.
# OPENAI_IMAGE_SIZE="1024x1024"
OPENAI_IMAGE_QUALITY="high"
SELF_SERVICE_MONTH_VISUAL_BUDGET_USD="3"
# YooKassa checkout. Configure the webhook URL in the YooKassa dashboard:
# https://your-public-app-domain.example/api/billing/yookassa/webhook
YOOKASSA_SHOP_ID="replace-with-shop-id"
YOOKASSA_SECRET_KEY="replace-with-secret-key"
# Optional when receipt data must be sent by the application (1–6 per YooKassa settings).
# YOOKASSA_VAT_CODE="1"
VISUAL_TEXT_MODE="image_text"
# n8n integration (platform <-> n8n). Keep secrets in env only, never in UI or logs.
N8N_WEBHOOK_URL="https://your-n8n-instance.example/webhook/aps"
N8N_SHARED_SECRET="replace-me-with-a-long-random-string"
# Article engine (writer): Claude is preferred for articles when the key is set.
ANTHROPIC_API_KEY="sk-ant-replace-me"
ARTICLE_MODEL_ANTHROPIC="claude-opus-4-8"
# ARTICLE_MODEL_OPENAI="gpt-5.6-sol" # Optional override; defaults to TEXT_MODEL_PREMIUM.
