generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                @id @default(cuid())
  name          String?
  email         String?               @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMembership[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id         String                    @id @default(cuid())
  name       String
  website    String?
  industry   String?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt
  briefs     ClientBrief[]
  blueprints ClientPresenceBlueprint[]
  monthlyPlans MonthlyOperatingPlan[]
  contentDrafts ContentDraft[]
  scheduledPublications ScheduledPublication[]
  creativeAssets CreativeAsset[]
  generatedCreativeVariants GeneratedCreativeVariant[]
  generationJobs GenerationJob[]
  monthProductionRuns MonthProductionRun[]
  monthProductionTasks MonthProductionTask[]
  clientPortalLinks ClientPortalLink[]
  brandProfile ClientBrandProfile?
  brandAssets ClientBrandAsset[]
  channels ClientChannel[]
  articles Article[]
  geoAudits GeoAudit[]
  memberships WorkspaceMembership[]
  subscription Subscription?
}

model WorkspaceMembership {
  id        String   @id @default(cuid())
  userId    String   @unique
  clientId  String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([role])
}

model Subscription {
  id                     String    @id @default(cuid())
  clientId               String    @unique
  planCode               String    @default("trial")
  status                 String    @default("pending")
  provider               String?
  providerCustomerId     String?   @unique
  providerSubscriptionId String?   @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  client                 Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([planCode])
}

model SelfServiceOnboardingDraft {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  email           String?
  payload         Json
  expiresAt       DateTime
  claimedAt       DateTime?
  claimedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@index([claimedAt])
  @@index([email])
}

model ClientBrief {
  id        String                   @id @default(cuid())
  clientId  String
  rawBrief  String
  createdAt DateTime                 @default(now())
  client    Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint ClientPresenceBlueprint?

  @@index([clientId])
}

model ClientBrandProfile {
  id                   String   @id @default(cuid())
  clientId             String   @unique
  toneOfVoice          String?
  keyMessages          String?
  targetAudienceNotes  String?
  brandColors          String?
  fonts                String?
  visualStyle          String?
  forbiddenTopics      String?
  requiredDisclaimers  String?
  legalNotes           String?
  productServiceNotes  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientBrandAsset {
  id              String   @id @default(cuid())
  clientId        String
  assetType       String
  title           String
  description     String?
  fileUrl         String?
  storageKey      String?
  storageProvider String   @default("vercel_blob")
  mimeType        String?
  fileSize        Int?
  textContent     String?
  sourceUrl       String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([assetType])
  @@index([status])
  @@index([createdAt])
}

model ClientPresenceBlueprint {
  id                             String                   @id @default(cuid())
  clientId                       String
  briefId                        String                   @unique
  clientSummary                  String
  businessGoals                  Json
  missingBriefFields             Json                     @default("[]")
  assumptions                    Json                     @default("[]")
  confidenceScore                Int                      @default(0)
  nextRecommendedAction          String                   @default("request_more_brief_data")
  notRecommendedPlatforms        Json
  recommendedMonthlyContentScope Json
  totalContentUnitsMin           Int                      @default(0)
  totalContentUnitsMax           Int                      @default(0)
  publishingFrequency            Json
  integrationRequirements        Json                     @default("[]")
  humanReviewPolicy              Json                     @default("{}")
  approvalMode                   String
  managerAttentionLevel          String
  rawBlueprintJson               Json
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  client                         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  brief                          ClientBrief              @relation(fields: [briefId], references: [id], onDelete: Cascade)
  selectedModules                PresenceModule[]
  platformRecommendations        PlatformRecommendation[]
  automationPlans                AutomationPlan[]
  riskRules                      RiskRule[]
  monthlyPlans                   MonthlyOperatingPlan[]
  contentDrafts                  ContentDraft[]
  scheduledPublications          ScheduledPublication[]
  creativeAssets                 CreativeAsset[]
  generatedCreativeVariants      GeneratedCreativeVariant[]
  generationJobs                 GenerationJob[]
  monthProductionRuns             MonthProductionRun[]
  monthProductionTasks            MonthProductionTask[]
  clientPortalLinks               ClientPortalLink[]

  @@index([clientId])
}

model MonthlyOperatingPlan {
  id                 String                @id @default(cuid())
  clientId           String
  blueprintId        String
  month              String
  version            Int                   @default(1)
  status             String
  summary            String
  totalPlannedUnits  Int
  approvalStrategy   String
  autopublishStrategy String
  riskSummary        String
  rawPlanJson        Json
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint          ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  modules            MonthlyPlanModule[]
  platforms          MonthlyPlanPlatform[]
  plannedContentItems PlannedContentItem[]
  managerTasks       ManagerTask[]
  contentDrafts       ContentDraft[]
  scheduledPublications ScheduledPublication[]
  creativeAssets      CreativeAsset[]
  generatedCreativeVariants GeneratedCreativeVariant[]
  generationJobs            GenerationJob[]
  productionRuns            MonthProductionRun[]
  productionTasks           MonthProductionTask[]
  clientPortalLinks          ClientPortalLink[]
  revisionProposals          MonthlyPlanRevisionProposal[]

  @@index([clientId])
  @@index([blueprintId])
  @@index([month])
  @@index([blueprintId, month])
}

model MonthlyPlanRevisionProposal {
  id              String               @id @default(cuid())
  monthlyPlanId   String
  instruction     String
  summary         String
  proposedChanges Json
  status          String               @default("draft")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  monthlyPlan     MonthlyOperatingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId])
  @@index([status])
}

model MonthlyPlanModule {
  id              String               @id @default(cuid())
  monthlyPlanId   String
  moduleType      String
  name            String
  priority        String
  plannedUnitsMin Int
  plannedUnitsMax Int
  rationale       String
  monthlyPlan     MonthlyOperatingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId])
}

model MonthlyPlanPlatform {
  id                              String               @id @default(cuid())
  monthlyPlanId                   String
  platformName                    String
  platformType                    String
  automationStatus                String
  plannedCadence                  String
  contentFormats                  Json                 @default("[]")
  requiresIntegrationBeforeLaunch Boolean
  rationale                       String
  monthlyPlan                     MonthlyOperatingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId])
}

model PlannedContentItem {
  id                  String               @id @default(cuid())
  monthlyPlanId       String
  moduleType          String
  platformName        String
  format              String
  topic               String
  goal                String
  plannedDate         String
  deliverableKind     String               @default("post")
  pairGroupId         String?
  week                String?
  campaignTheme       String?
  contentPillar       String?
  channelRole         String?
  sequenceReason      String?
  approvalRequired    Boolean
  autopublishEligible Boolean
  requiredInputs      Json                 @default("[]")
  status              String
  monthlyPlan         MonthlyOperatingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  contentDraft        ContentDraft?
  scheduledPublications ScheduledPublication[]
  creativeAssets      CreativeAsset[]
  generatedCreativeVariants GeneratedCreativeVariant[]
  generationJobs              GenerationJob[]
  productionTasks             MonthProductionTask[]

  @@index([monthlyPlanId])
  @@index([pairGroupId])
}

model ContentDraft {
  id                   String                  @id @default(cuid())
  clientId             String
  blueprintId          String
  monthlyPlanId        String
  plannedContentItemId String                  @unique
  platformName         String
  format               String
  topic                String
  goal                 String
  draftTitle           String
  draftBody            String
  telegramBody         String?
  draftNotes           Json                    @default("[]")
  status               String
  approvalRequired     Boolean
  autopublishEligible  Boolean
  riskLevel            String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint            ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan          MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  plannedContentItem   PlannedContentItem      @relation(fields: [plannedContentItemId], references: [id], onDelete: Cascade)
  reviewEvents         ContentDraftReviewEvent[]
  scheduledPublications ScheduledPublication[]
  creativeAssets       CreativeAsset[]
  generatedCreativeVariants GeneratedCreativeVariant[]
  generationJobs              GenerationJob[]
  productionTasks             MonthProductionTask[]

  @@index([clientId])
  @@index([blueprintId])
  @@index([monthlyPlanId])
}

model ContentDraftReviewEvent {
  id             String       @id @default(cuid())
  contentDraftId String
  actorType      String
  action         String
  comment        String?
  createdAt      DateTime     @default(now())
  contentDraft   ContentDraft @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)

  @@index([contentDraftId])
}

model ScheduledPublication {
  id                   String                  @id @default(cuid())
  clientId             String
  blueprintId          String
  monthlyPlanId        String
  plannedContentItemId String
  contentDraftId       String
  platformName         String
  format               String
  topic                String
  scheduledDate        String
  scheduledTime        String?
  timezone             String?
  status               String
  publishMode          String
  notes                String?
  externalUrl          String?
  externalId           String?
  publishedAt          DateTime?
  publishStatus        String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint            ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan          MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  plannedContentItem   PlannedContentItem      @relation(fields: [plannedContentItemId], references: [id], onDelete: Cascade)
  contentDraft         ContentDraft            @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  creativeAssets       CreativeAsset[]
  generatedCreativeVariants GeneratedCreativeVariant[]
  generationJobs             GenerationJob[]
  metrics                    PublicationMetric[]
  results                    PublicationResult[]

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([contentDraftId])
  @@index([status])
}

model PublicationResult {
  id                     String               @id @default(cuid())
  scheduledPublicationId String
  clientId               String
  platform               String
  channelRecordId        String?
  externalId             String
  externalUrl            String
  imagesSent             Int                  @default(0)
  textTruncated          Boolean              @default(false)
  publishedAt            DateTime             @default(now())
  createdAt              DateTime             @default(now())
  scheduledPublication   ScheduledPublication @relation(fields: [scheduledPublicationId], references: [id], onDelete: Cascade)

  @@unique([scheduledPublicationId, platform])
  @@index([clientId])
  @@index([platform])
  @@index([publishedAt])
}

model CreativeAsset {
  id                     String                  @id @default(cuid())
  clientId               String
  blueprintId            String
  monthlyPlanId          String
  plannedContentItemId   String
  contentDraftId         String
  scheduledPublicationId String
  assetType              String
  title                  String
  brief                  String
  formatRequirements     String?
  textOnAsset            String?
  references             String?
  status                 String
  source                 String                  @default("manual")
  approvalRequired       Boolean
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint              ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan            MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  plannedContentItem     PlannedContentItem      @relation(fields: [plannedContentItemId], references: [id], onDelete: Cascade)
  contentDraft           ContentDraft            @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  scheduledPublication   ScheduledPublication    @relation(fields: [scheduledPublicationId], references: [id], onDelete: Cascade)
  generatedVariants      GeneratedCreativeVariant[]
  generationJobs          GenerationJob[]
  productionTasks         MonthProductionTask[]

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([scheduledPublicationId])
  @@index([status])
}

model GeneratedCreativeVariant {
  id                     String                  @id @default(cuid())
  clientId               String
  blueprintId            String
  monthlyPlanId          String
  plannedContentItemId   String
  contentDraftId         String
  scheduledPublicationId String
  creativeAssetId        String
  variantTitle           String
  prompt                 String
  revisedPrompt          String?
  imageBase64            String?
  imageUrl               String?
  storageKey             String?
  storageProvider        String                  @default("database_base64")
  fileSize               Int?
  mimeType               String                  @default("image/png")
  status                 String
  source                 String                  @default("openai")
  provider               String                  @default("openai")
  model                  String?
  quality                String?
  size                   String?
  textMode               String?
  inputTokens            Int?
  outputTokens           Int?
  totalTokens            Int?
  estimatedCostUsd       Float?
  qualityStatus          String                  @default("unchecked")
  qualityNotes           String?
  notes                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint              ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan            MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  plannedContentItem     PlannedContentItem      @relation(fields: [plannedContentItemId], references: [id], onDelete: Cascade)
  contentDraft           ContentDraft            @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)
  scheduledPublication   ScheduledPublication    @relation(fields: [scheduledPublicationId], references: [id], onDelete: Cascade)
  creativeAsset          CreativeAsset           @relation(fields: [creativeAssetId], references: [id], onDelete: Cascade)
  generationJobs         GenerationJob[]

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([monthlyPlanId, createdAt])
  @@index([creativeAssetId])
  @@index([status])
  @@index([storageProvider])
}

model GenerationJob {
  id                         String                    @id @default(cuid())
  clientId                   String?
  blueprintId                String?
  monthlyPlanId              String?
  plannedContentItemId       String?
  contentDraftId             String?
  scheduledPublicationId     String?
  creativeAssetId            String?
  generatedCreativeVariantId String?
  jobType                    String
  status                     String
  title                      String
  message                    String?
  errorMessage               String?
  resultSummary              String?
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  client                     Client?                   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  blueprint                  ClientPresenceBlueprint?  @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  monthlyPlan                MonthlyOperatingPlan?     @relation(fields: [monthlyPlanId], references: [id], onDelete: SetNull)
  plannedContentItem         PlannedContentItem?       @relation(fields: [plannedContentItemId], references: [id], onDelete: SetNull)
  contentDraft               ContentDraft?             @relation(fields: [contentDraftId], references: [id], onDelete: SetNull)
  scheduledPublication       ScheduledPublication?     @relation(fields: [scheduledPublicationId], references: [id], onDelete: SetNull)
  creativeAsset              CreativeAsset?            @relation(fields: [creativeAssetId], references: [id], onDelete: SetNull)
  generatedCreativeVariant   GeneratedCreativeVariant? @relation(fields: [generatedCreativeVariantId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([creativeAssetId])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

model MonthProductionRun {
  id              String                  @id @default(cuid())
  clientId        String
  blueprintId     String
  monthlyPlanId   String
  status          String                  @default("queued")
  currentStage    String                  @default("planning")
  totalTasks      Int                     @default(0)
  completedTasks  Int                     @default(0)
  failedTasks     Int                     @default(0)
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  client          Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint       ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan     MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  tasks           MonthProductionTask[]

  @@index([clientId])
  @@index([blueprintId])
  @@index([monthlyPlanId])
  @@index([status])
  @@index([currentStage])
  @@index([createdAt])
}

model MonthProductionTask {
  id                   String                  @id @default(cuid())
  productionRunId      String
  clientId             String
  blueprintId          String
  monthlyPlanId        String
  plannedContentItemId String?
  contentDraftId       String?
  creativeAssetId      String?
  stage                String
  taskType             String
  status               String                  @default("queued")
  title                String
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  productionRun        MonthProductionRun      @relation(fields: [productionRunId], references: [id], onDelete: Cascade)
  client               Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint            ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan          MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  plannedContentItem   PlannedContentItem?     @relation(fields: [plannedContentItemId], references: [id], onDelete: SetNull)
  contentDraft         ContentDraft?           @relation(fields: [contentDraftId], references: [id], onDelete: SetNull)
  creativeAsset        CreativeAsset?          @relation(fields: [creativeAssetId], references: [id], onDelete: SetNull)

  @@index([productionRunId])
  @@index([monthlyPlanId])
  @@index([plannedContentItemId])
  @@index([creativeAssetId])
  @@index([status])
  @@index([stage])
  @@index([taskType])
  @@index([createdAt])
}

model ClientPortalLink {
  id            String                  @id @default(cuid())
  clientId      String
  blueprintId   String
  monthlyPlanId String
  tokenHash     String                  @unique
  tokenPrefix   String
  label         String?
  status        String                  @default("active")
  expiresAt     DateTime?
  lastOpenedAt  DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  client        Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  blueprint     ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  monthlyPlan   MonthlyOperatingPlan    @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([status])
  @@index([createdAt])
}

model ManagerTask {
  id            String               @id @default(cuid())
  monthlyPlanId String
  title         String
  description   String
  priority      String
  dueDate       String
  status        String
  monthlyPlan   MonthlyOperatingPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@index([monthlyPlanId])
}

model PresenceModule {
  id                   String                  @id @default(cuid())
  blueprintId          String
  moduleType           String                  @default("custom")
  name                 String
  purpose              String
  rationale            String
  priority             String
  monthlyContentScope  Json
  blueprint            ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model PlatformRecommendation {
  id                    String                  @id @default(cuid())
  blueprintId           String
  platformName          String
  platformType          String                  @default("other")
  recommendation        String
  priority              String                  @default("medium")
  automationStatus      String                  @default("needs_verification")
  requiredCredentials   Json                    @default("[]")
  permissionsNeeded     Json                    @default("[]")
  contentFormats        Json                    @default("[]")
  rationale             String
  contentRole           String
  suggestedFrequency    String
  automationOpportunity String
  blueprint             ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model AutomationPlan {
  id              String                  @id @default(cuid())
  blueprintId     String
  name            String
  trigger         String
  action          String
  humanCheckpoint String
  toolCategory    String
  priority        String
  blueprint       ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model RiskRule {
  id               String                  @id @default(cuid())
  blueprintId      String
  ruleName         String
  riskDescription  String
  preventionAction String
  severity         String
  approvalRequired Boolean
  blueprint        ClientPresenceBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
}

model PublicationMetric {
  id                     String                @id @default(cuid())
  scheduledPublicationId String?
  plannedContentItemId   String?
  clientId               String
  monthlyPlanId          String
  platformName           String
  likes                  Int?
  comments               Int?
  shares                 Int?
  reach                  Int?
  views                  Int?
  saves                  Int?
  clicks                 Int?
  capturedAt             DateTime              @default(now())
  source                 String                @default("manual")
  createdAt              DateTime              @default(now())
  scheduledPublication   ScheduledPublication? @relation(fields: [scheduledPublicationId], references: [id], onDelete: Cascade)

  @@index([scheduledPublicationId])
  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([platformName])
  @@index([capturedAt])
}

model IntegrationEvent {
  id           String    @id @default(cuid())
  direction    String
  eventType    String
  relatedType  String?
  relatedId    String?
  payload      Json
  status       String    @default("queued")
  errorMessage String?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  sentAt       DateTime?
  processedAt  DateTime?

  @@index([eventType])
  @@index([status])
  @@index([relatedId])
  @@index([createdAt])
}

model IntegrationSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id                   String   @id @default(cuid())
  clientId             String
  blueprintId          String?
  monthlyPlanId        String?
  plannedContentItemId String?
  title                String
  angle                String?
  geoFocus             String?
  targetQueries        Json     @default("[]")
  briefJson            Json?
  bodyMarkdown         String   @default("")
  faq                  Json     @default("[]")
  schemaJsonLd         Json?
  metaTitle            String?
  metaDescription      String?
  sources              Json     @default("[]")
  images               Json     @default("[]")
  calloutNotes         Json     @default("[]")
  wordCount            Int?
  model                String   @default("")
  provider             String   @default("")
  platformTarget       String?
  stage                String   @default("brief")
  status               String   @default("draft")
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([monthlyPlanId])
  @@index([status])
  @@index([createdAt])
}

model ClientChannel {
  id                  String    @id @default(cuid())
  clientId            String
  platform            String    @default("telegram")
  channelId           String
  title               String?
  status              String    @default("active")
  credentialEncrypted String?
  credentialHint      String?
  autopublishEnabled  Boolean   @default(false)
  connectedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([platform])
  @@index([status])
}

model GeoAudit {
  id               String   @id @default(cuid())
  clientId         String
  auditDate        DateTime
  periodLabel      String
  presenceIndex    Int      @default(0)
  sovScore         Int      @default(0)
  sovMax           Int      @default(40)
  positionScore    Int      @default(0)
  positionMax      Int      @default(25)
  toneScore        Int      @default(0)
  toneMax          Int      @default(20)
  accuracyScore    Int      @default(0)
  accuracyMax      Int      @default(15)
  sovPercent       Float    @default(0)
  mentionPercent   Float    @default(0)
  queriesTotal     Int      @default(0)
  queriesCategorical Int    @default(0)
  queriesBrand     Int      @default(0)
  reportFileUrl    String?
  reportStorageKey String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  engineResults    GeoEngineResult[]
  competitors      GeoCompetitor[]
  sources          GeoSource[]
  growthPoints     GeoGrowthPoint[]

  @@index([clientId])
  @@index([auditDate])
  @@index([clientId, auditDate])
}

model GeoEngineResult {
  id          String   @id @default(cuid())
  geoAuditId  String
  engine      String
  mentions    Int      @default(0)
  spontaneous Int      @default(0)
  geoAudit    GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  @@index([geoAuditId])
}

model GeoCompetitor {
  id           String   @id @default(cuid())
  geoAuditId   String
  name         String
  mentions     Int      @default(0)
  sharePercent Float?
  note         String?
  geoAudit     GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  @@index([geoAuditId])
}

model GeoSource {
  id         String   @id @default(cuid())
  geoAuditId String
  domain     String
  citations  Int?
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  @@index([geoAuditId])
}

model GeoGrowthPoint {
  id         String   @id @default(cuid())
  geoAuditId String
  area       String
  citations  Int?
  note       String?
  geoAudit   GeoAudit @relation(fields: [geoAuditId], references: [id], onDelete: Cascade)

  @@index([geoAuditId])
}
